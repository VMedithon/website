{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Frontend-only deployment: static assets served by a Workers static-assets
  // host, no Worker script. Deploy with: wrangler deploy -c wrangler.frontend.jsonc
  "name": "vmedithon-frontend",
  "account_id": "ee4c08f37c3a62fedc87fbd1b8b96ff4",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
