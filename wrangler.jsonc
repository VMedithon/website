{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: no "main" entrypoint, so every request is served
  // straight from the asset store. Asset requests are free and unbilled; adding a
  // "main" script would make requests that reach it billable.
  // Deploy with: bun run deploy
  "name": "vmedithon",
  "account_id": "ee4c08f37c3a62fedc87fbd1b8b96ff4",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths instead of a bare 404.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
